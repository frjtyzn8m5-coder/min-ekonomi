# ── Firebase (client) ─────────────────────────────────────────────────────────
# From Firebase console → Project settings → Your apps. These are public by design
# (the real access control is firestore.rules), but still required to run the app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase (server / admin) ─────────────────────────────────────────────────
# REQUIRED for the authenticated push endpoints (api/subscribe, api/sync-reminders).
# Firebase console → Project settings → Service accounts → "Generate new private key".
# Paste the ENTIRE downloaded JSON as a single-line string (keep the \n in private_key).
# Without this, those endpoints reject all requests (fail closed) and push stops working.
FIREBASE_SERVICE_ACCOUNT=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generera VAPID-nycklar: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# ── App PIN ───────────────────────────────────────────────────────────────────
# Generera PIN-hash: node -e "const c=require('crypto');console.log(c.createHash('sha256').update('DITTPIN').digest('hex'))"
VITE_APP_PIN_HASH=

# ── Cron ──────────────────────────────────────────────────────────────────────
# Shared secret the Vercel cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── Upstash Redis / Vercel KV ─────────────────────────────────────────────────
# Sätts automatiskt av Vercel KV (Storage-fliken i dashboarden)
KV_REST_API_URL=
KV_REST_API_TOKEN=
